NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback if a publishable key is not used:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Used only by scoped Figma pairing/sync endpoints; never put in the plugin.
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after wildcard DNS, TLS, domain attachment and migrations are verified.
PASSFLOW_EVENT_SUBDOMAINS_ENABLED=false
# Optional server-only JSON: webhook ID -> {"passcode":"32+ random characters","fileKey":"verified Figma file key"}.
# Provision FILE_UPDATE webhooks separately after release authorization. Never expose passcodes in the plugin.
FIGMA_WEBHOOK_CONNECTIONS=
# SMTP and Google OAuth client secrets belong in Supabase Auth settings, never here.
